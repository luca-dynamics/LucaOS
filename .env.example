# LUCA OS Environment Configuration
# Copy this file to .env and fill in your API keys
# DO NOT commit .env to git - it contains sensitive credentials

# ============================================================
# SECURITY (Recommended for production)
# ============================================================

# Vault encryption key — 64 hex chars (32 bytes).
# If not set, an ephemeral random key is generated on each restart
# and encrypted credentials will NOT persist across restarts.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# LUCA_VAULT_KEY=

# Master auth token — auto-generated and stored on disk if not set.
# Override via env to keep the token consistent across deployments.
# LUCA_SECRET=

# CORS allowed origins — comma-separated list.
# Defaults to http://localhost:3000,http://127.0.0.1:3000
# Set to your actual domain(s) in production.
# LUCA_CORS_ORIGINS=https://yourdomain.com,http://localhost:3000

# Hotspot credentials (required only if using the hotspot feature)
# LUCA_HOTSPOT_SSID=Luca_Secure
# LUCA_HOTSPOT_KEY=

# ============================================================
# AI / LLM PROVIDER KEYS
# ============================================================

# Google Gemini API Key (Required)
# Get your key from: https://makersuite.google.com/app/apikey
VITE_API_KEY=your_gemini_api_key_here
API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
VITE_GCP_TTS_API_KEY=your_gcp_tts_api_key_here

# Optional: Other LLM Provider Keys (if you want to use them)
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OLLAMA_BASE_URL=http://localhost:11434

# ============================================================
# INTEGRATIONS
# ============================================================

# Google OAuth (for Gmail/Drive/Calendar integration)
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Notion OAuth (for Notion page sync)
# Get from: https://www.notion.so/my-integrations
NOTION_CLIENT_SECRET=your_notion_client_secret_here

# Optional: Third-party integrations
# GITHUB_TOKEN=your_github_personal_access_token
# BRAVE_API_KEY=your_brave_search_api_key
# CALENDLY_API_KEY=your_calendly_api_key
# KLAVIS_API_KEY=your_klavis_api_key

# ============================================================
# SERVER / NETWORKING
# ============================================================

# Backend API URL (for frontend to connect to local server)
# Change this if your backend runs on a different port or domain
# Default: http://localhost:3002
VITE_API_URL=http://localhost:3002
VITE_WS_PORT=3003
VITE_CORTEX_URL=http://localhost:8000
VITE_AUTH_DOMAIN=http://localhost:3001
VITE_FRONTEND_PORT=3000
AUTH_PORT=3001
VITE_RELAY_SERVER_URL=https://your-relay-app-name.vercel.app
