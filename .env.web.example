# LucaOS public web preview build example.
# Copy only client-safe values into Vite/Vercel build settings.

# Client-safe build target metadata.
VITE_LUCA_RELEASE_TARGET=web
VITE_LUCA_RUNTIME_TARGET=vercel
VITE_LUCA_APP_MODE=web

# Public feature flags only. These disable local/desktop assumptions for web preview builds.
VITE_ENABLE_DESKTOP_RUNTIME=false
VITE_ENABLE_LOCAL_MODEL_SCAN=false
VITE_ENABLE_LOCAL_OLLAMA=false
VITE_ENABLE_FILESYSTEM_MEMORY=false
VITE_ENABLE_LUCALINK_NATIVE_CONTROL=false

# Public API origin. This is not a secret.
# Leave empty for unauthenticated preview until api.lucaos.space exists.
# Future value: VITE_LUCA_API_URL=https://api.lucaos.space
VITE_LUCA_API_URL=

# Optional public cloud endpoints, if deliberately enabled and documented.
VITE_CLOUD_API_URL=
VITE_CLOUD_CORTEX_URL=

# -----------------------------------------------------------------------------
# SERVER-ONLY VALUES — never put these in Vite/Vercel client build variables.
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# API_KEY=
# Luca-managed provider credentials must live server-side behind api.lucaos.space.
# Do not put provider secrets in any VITE_ variable, including VITE_OPENAI_API_KEY,
# VITE_ANTHROPIC_API_KEY, VITE_GEMINI_API_KEY, or VITE_API_KEY.
