{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "outDir": "dist",
    "baseUrl": "../..",
    "paths": {
      "@luca/orb-design": ["packages/luca-orb-design/src/index.ts"],
      "@luca/orb-design/*": ["packages/luca-orb-design/src/*"]
    }
  },
  "include": ["src/**/*"]
}
