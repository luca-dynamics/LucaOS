# Vercel Web Preview client-safe variables for the root LucaOS Vite app.
# Keep provider credentials out of the Vite/browser build environment.

VITE_LUCA_RELEASE_TARGET=web
VITE_LUCA_APP_MODE=web
VITE_LUCA_RUNTIME_TARGET=vercel
VITE_ENABLE_DESKTOP_RUNTIME=false
VITE_ENABLE_LOCAL_MODEL_SCAN=false
VITE_ENABLE_LOCAL_OLLAMA=false
VITE_ENABLE_FILESYSTEM_MEMORY=false
VITE_ENABLE_LUCALINK_NATIVE_CONTROL=false

# Canonical public API origin. This is not a secret.
# Leave empty until the backend exists; future value:
# VITE_LUCA_API_URL=https://api.lucaos.space
VITE_LUCA_API_URL=

# Optional public cloud endpoints only; document any non-empty values before use.
VITE_CLOUD_API_URL=
VITE_CLOUD_CORTEX_URL=

# Server-only provider secrets must live behind api.lucaos.space, never in Vite:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# API_KEY=
# Do not create VITE_* provider secret variables.
