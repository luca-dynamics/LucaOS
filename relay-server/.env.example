# Relay Server Configuration
PORT=3003

# Security (optional - for production)
# LUCA_CORS_ORIGINS=https://yourdomain.com,https://mobile.yourdomain.com
# MAX_DEVICES_PER_USER=5
# RATE_LIMIT_MESSAGES_PER_MINUTE=100

# --- Authentication (REQUIRED; endpoints fail closed without these) ---
# Shared secret the owner's desktop sends as the `X-Relay-Secret` header to mint
# pairing tokens. Without it, POST /api/pairing/generate is disabled (503).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# LUCA_RELAY_PAIRING_SECRET=

# Telegram bot gateway. The webhook is rejected (401) unless the secret token
# matches what you registered via setWebhook. Only allowlisted chats are acted on.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_ALLOWED_CHAT_IDS=123456789,987654321

# Discord bot gateway. Interactions are rejected (401) unless the Ed25519
# signature verifies against the application public key. Only allowlisted users act.
# DISCORD_BOT_TOKEN=
# DISCORD_PUBLIC_KEY=
# DISCORD_ALLOWED_USER_IDS=1111111111,2222222222
